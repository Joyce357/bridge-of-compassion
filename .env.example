# ─── Bridge of Compassion — Environment Variables ────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file with real credentials to Git.

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Neon provides two URLs: a pooled URL for the app and a direct URL for Prisma migrations.
# Get both from: https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=
# The canonical URL of this deployment (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# ─── Admin Seed Account ───────────────────────────────────────────────────────
# Used only during: npx prisma db seed
# These credentials are never stored in the application — only the bcrypt hash is.
ADMIN_EMAIL=admin@bridgeofcompassion.org
ADMIN_INITIAL_PASSWORD=

# ─── Email (Resend — connect later) ──────────────────────────────────────────
# Leave blank in development; email will be logged to console instead.
RESEND_API_KEY=
EMAIL_FROM=no-reply@bridgeofcompassion.org

# ─── Rate Limiting (Upstash Redis) ────────────────────────────────────────────
# Required in production for public submission endpoints.
# Create a free Redis database at: https://console.upstash.com
# In development, rate limiting gracefully skips if these are not set.
# In production, public endpoints will be blocked if Redis is not configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Donation Payment Provider (connect later) ────────────────────────────────
# Leave blank until a payment provider is chosen.
# The architecture is abstracted — connect Stripe, PayPal, etc. here.
DONATION_PROVIDER=
DONATION_PROVIDER_KEY=
DONATION_PROVIDER_SECRET=

# ─── Media Storage (Cloudinary) ───────────────────────────────────────────────
# Required for durable media uploads (admin avatars, programs, events, news, gallery).
# Get credentials from: https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
