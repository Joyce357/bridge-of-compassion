# ─── Bridge of Compassion — Production Environment Variables ─────────────────
# Copy this file to .env.local for local development.
# In production (e.g. Vercel), configure these variables in the project settings.
# NEVER commit .env.local or any file containing real credentials to Git.

# ─── Site & Canonical SEO URL ─────────────────────────────────────────────────
# The fully-qualified production site domain (no trailing slash).
# Used for canonical tags, OpenGraph URLs, JSON-LD, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://bridgeofcompassion.org

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Neon provides two connection strings:
#   DATABASE_URL: Pooled connection for the Next.js runtime (via @prisma/adapter-pg + pg.Pool)
#   DIRECT_URL:   Direct non-pooled connection for Prisma CLI migrations & schema DDL
# Get both from: https://console.neon.tech → your project → Connection Details
# Append sslmode=verify-full or sslmode=require for secure TLS connections.
DATABASE_URL=postgresql://user:password@ep-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
DIRECT_URL=postgresql://user:password@ep-direct.region.aws.neon.tech/neondb?sslmode=verify-full

# ─── NextAuth (Authentication) ────────────────────────────────────────────────
# Generate a strong 32-byte secret: openssl rand -base64 32
NEXTAUTH_SECRET=
# The canonical URL of this deployment (no trailing slash)
NEXTAUTH_URL=https://bridgeofcompassion.org

# ─── Admin Seed Account / Notification Recipient ──────────────────────────────
# ADMIN_EMAIL: Recipient for public contact/volunteer notifications and default Reply-To
# ADMIN_INITIAL_PASSWORD: Used only during initial `npx prisma db seed` (min 10 chars, never stored plaintext)
ADMIN_EMAIL=admin.bridgeofcompassion@gmail.com
ADMIN_INITIAL_PASSWORD=

# ─── Email Provider (Resend) ──────────────────────────────────────────────────
# Required for production delivery of contact replies, volunteer updates, and donation receipts.
# Obtain API key from: https://resend.com/api-keys
# In development without an API key, email payloads are logged to the console.
RESEND_API_KEY=
# Authenticated sender address matching your verified domain in Resend:
EMAIL_FROM=no-reply@bridgeofcompassion.org

# ─── Rate Limiting (Upstash Redis) ────────────────────────────────────────────
# Protects public form submission endpoints (/api/contact, /api/volunteer, /api/newsletter, /api/donations).
# Create a free Redis database at: https://console.upstash.com
# In development, rate limiting gracefully skips if these are absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Donation Payment Provider (PayPal Sandbox / Live) ─────────────────────────
# Get credentials from: https://developer.paypal.com → Dashboard → Apps & Credentials
# Set PAYPAL_ENV to "sandbox" for testing, or "live" for production payment processing.
PAYPAL_ENV=sandbox
# Server-side REST API credentials (kept secret):
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Client-side JavaScript SDK Client ID (public, must match the PayPal account in use):
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Webhook ID from PayPal Dashboard for cryptographic webhook signature verification:
PAYPAL_WEBHOOK_ID=

# ─── Media Storage (Cloudinary) ───────────────────────────────────────────────
# Required for persistent media uploads (admin avatars, news hero images, gallery items).
# Get credentials from: https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

